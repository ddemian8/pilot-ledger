# Browser-safe Supabase values (Vite exposes only variables prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare deployment (configure these in GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=replace-in-github-secrets
CLOUDFLARE_ACCOUNT_ID=replace-in-github-secrets
