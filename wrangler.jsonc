{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pilot-ledger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "pilot-ledger-prod", "database_id": "9a4a02df-ccaa-4865-9bb3-2287c571b1ff", "migrations_dir": "./migrations" }],
  "observability": { "enabled": true }
}
